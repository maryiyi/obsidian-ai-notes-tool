# ==============================================================================
# Obsidian AI Notes Tool - Environment Configuration
# ==============================================================================

# Absolute path to your Obsidian vault target folder
OBSIDIAN_VAULT_PATH="/Users/YourName/Documents/Obsidian/University"

# Local endpoint for LM Studio (OpenAI-compatible)
API_BASE_URL="http://localhost:1234/v1"

# API Key (placeholder required by OpenAI SDK format, ignored by LM Studio)
API_KEY="lm-studio"

# Target model identifier in LM Studio (defaults to 'local-model' if not specified)
# LM Studio routes to whatever model is loaded in memory if default is passed
MODEL_NAME="local-model"

# Sampling temperature (0.0 to 1.0; 0.2 recommended for deterministic, structured notes)
TEMPERATURE="0.2"

# Path to system prompt harness markdown file
HARNESS_PATH="harness.md"
